# 复制成 .env 后填入真实值。.env 已被 .gitignore 排除,不会进版本库。
# 绝对不要把真实密钥写进这个文件。

# ---- 大模型 ----
# 走 OpenAI 兼容协议的服务都填这里,换供应商只改 BASE_URL
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# ---- Embedding / Rerank ----
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- 向量库 (Milvus) ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
# Ch04 新 schema；不要把新版应用指向旧 dense-only knowledge 集合
MILVUS_COLLECTION=knowledge_ch04

# ---- Ch04 证据门控 ----
# 先运行 prepare/calibrate，再填写实际产物的路径。缺失会显式报错。
RAG_CALIBRATION_PATH=artifacts/ch04/ch04_20260930_03/calibration.json
# UTF-8 字节保守预算（含消息/结构及预留）；需核实供应商上下文限制后显式设置。
# 本次实测配置为 32000；不是供应商 token 数，也不会静默截断原文。
RAG_CONTEXT_BUDGET=32000
# 必须与 ingest --docs 使用同一原文目录；移动目录后需重新 ingest/sync。
KNOWLEDGE_DOCS_ROOT=knowledge-docs

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=mewhelp

# ---- 可观测 (Langfuse) ----
LANGFUSE_PUBLIC_KEY=pk-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- 应用 ----
APP_ENV=dev
LOG_LEVEL=INFO

# Ch05：官方 SQLite checkpointer，单实例运行
CH05_CHECKPOINT_PATH=data/ch05/checkpoints.sqlite3
CH05_MAX_DECISIONS=4
CH05_MAX_TOOLS=8
CH05_FINAL_MAX_TOKENS=1024
CH05_DECISION_MAX_TOKENS=256
CH05_CLASSIFIER_MAX_TOKENS=128
# 可选累计费用硬上限；省略时 ch07 按窗口×最多模型调用数推导（显式设置仍优先）。
# CH05_TOTAL_MODEL_TOKENS=64000
CH05_TURN_SECONDS=180
CH05_REQUEST_SECONDS=30
CH05_MAX_RETRIES=0

# Ch06：沿用上游，先用主模型；本章实测上游为 DeepSeek。
# 使用别的已有上游时须显式填写它实际支持的够格模型，不修改共享 LLM_MODEL。
CH06_PRIMARY_MODEL=deepseek-v4-pro
CH06_CASCADE_ENABLED=false
# 降级模式需显式启用并配置不同的小模型，再分别校准；不能沿用主模型校准。
# CH06_SMALL_MODEL=deepseek-flash
CH06_CALIBRATION_PATH=artifacts/ch06/ch06_20261002_07/calibration-primary-reused/router.json
CH06_POLICY_CALIBRATION_PATH=artifacts/ch06/ch06_20261002_01/policy-calibration-02/policy.json
CH06_UNDERSTANDING_MAX_TOKENS=512
CH06_EXPANSION_MAX_TOKENS=512
CH06_ASSESSMENT_MAX_TOKENS=768

# Ch07：当前会话上下文。窗口与单轮累计成本是两项独立约束。
# 以下窗口须在上游确有此能力时启用；校准后的 profile 与计数器一起加载。
MODEL_CONTEXT_WINDOW=128000
MAX_OUTPUT_TOKENS=4096
MAX_USER_INPUT_TOKENS=4096
MAX_AGENT_STEPS=4
TOOL_RESULT_MAX_TOKENS=1200
RERANK_TOP_K=10
# CONTEXT_CALIBRATION_PATH=artifacts/ch07/<run>/token-calibration/profile.json
# 演示：18000 / 2000 / 2000 / 3 / 1200 / 5，联合标定历史5300、L1 3709、L2 1590。
