# 仓库内统一用 LF,检出到 Windows 时按本地习惯处理。
# 这样既不会有换行符警告,推到 GitHub / 别人在 Linux 上 clone 也不会整文件 diff。
* text=auto

# 明确指定文本类型
*.py    text
*.md    text
*.toml  text
*.yml   text
*.yaml  text
*.json  text
*.txt   text

# Windows 下需要 CRLF 的脚本
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制,别碰
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.xlsx  binary
*.safetensors binary
*.bin   binary
*.gguf  binary
